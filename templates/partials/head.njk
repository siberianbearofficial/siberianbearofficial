    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ page.title }}</title>
    <meta name="description" content="{{ page.description | attr }}" />
    <meta name="theme-color" content="#0d1727" />
    <link rel="canonical" href="{{ page.canonical }}" />
    {% for alternate in page.alternates -%}
    <link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ alternate.href }}" />
    {% endfor -%}
    <meta property="og:type" content="{{ page.og_type }}" />
    <meta property="og:site_name" content="{{ identity.name | attr }}" />
    <meta property="og:title" content="{{ page.title | attr }}" />
    <meta property="og:description" content="{{ page.description | attr }}" />
    <meta property="og:url" content="{{ page.canonical }}" />
    <meta property="og:locale" content="{{ page.og_locale }}" />
    <meta property="og:locale:alternate" content="{{ page.og_locale_alternate }}" />
    <meta property="og:image" content="{{ page.og_image }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ page.title | attr }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ page.title | attr }}" />
    <meta name="twitter:description" content="{{ page.description | attr }}" />
    <meta name="twitter:image" content="{{ page.og_image }}" />
    <meta name="twitter:image:alt" content="{{ page.title | attr }}" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
