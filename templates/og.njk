<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8" />
    <title>{{ title }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=Golos+Text:wght@700;800&family=IBM+Plex+Sans:wght@400;600&display=swap"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Same reason as the site stylesheet: Bricolage Grotesque has no
         Cyrillic, so the Russian cards need their own display face. */
      html {
        --og-display-font: "Bricolage Grotesque", system-ui, sans-serif;
      }

      html[lang="ru"] {
        --og-display-font: "Golos Text", system-ui, sans-serif;
      }

      body {
        width: 1200px;
        height: 630px;
        display: flex;
        align-items: center;
        gap: 64px;
        padding: 72px 80px;
        background:
          radial-gradient(900px 520px at 88% 12%, rgba(36, 92, 255, 0.42), transparent 70%),
          radial-gradient(760px 480px at 6% 92%, {{ accent_glow }}, transparent 72%),
          #090d1a;
        color: #e5ecf8;
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        overflow: hidden;
      }

      .copy {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 26px;
      }

      .kicker {
        display: inline-block;
        align-self: flex-start;
        border: 1px solid rgba(229, 236, 248, 0.28);
        border-radius: 999px;
        padding: 10px 22px;
        font-size: 21px;
        font-weight: 600;
        letter-spacing: 0.02em;
        color: {{ accent }};
      }

      .title {
        font-family: var(--og-display-font);
        font-weight: 800;
        font-size: {{ title_size }}px;
        line-height: 1.04;
        letter-spacing: -0.03em;
        color: #ffffff;
      }

      .subtitle {
        font-size: 30px;
        line-height: 1.3;
        color: rgba(229, 236, 248, 0.82);
      }

      .footer {
        margin-top: 6px;
        padding-top: 24px;
        border-top: 1px solid rgba(229, 236, 248, 0.18);
        font-size: 22px;
        color: rgba(229, 236, 248, 0.72);
      }

      .portrait {
        flex: 0 0 auto;
        width: 330px;
        height: 330px;
        border-radius: 999px;
        object-fit: cover;
        object-position: center 20%;
        border: 6px solid {{ accent }};
        box-shadow: 18px 18px 0 rgba(9, 13, 26, 0.55);
      }

      .domain {
        position: absolute;
        right: 80px;
        bottom: 58px;
        font-size: 22px;
        font-weight: 600;
        color: rgba(229, 236, 248, 0.62);
      }
    </style>
  </head>
  <body>
    <div class="copy">
      <span class="kicker">{{ kicker }}</span>
      <h1 class="title">{{ title }}</h1>
      <p class="subtitle">{{ subtitle }}</p>
      <p class="footer">{{ footer }}</p>
    </div>
    <img class="portrait" src="{{ avatar_url }}" alt="" />
    <span class="domain">{{ domain }}</span>
  </body>
</html>
