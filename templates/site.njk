<!doctype html>
<html lang="{{ lang }}">
  <head>
    {% include "partials/head.njk" %}
    {% include "partials/boot-scripts.njk" %}
    <link rel="stylesheet" href="/assets/site.css" />
    <script type="application/ld+json">{{ structured_data | json }}</script>
  </head>
  <body data-page="site">
    <div class="site-backdrop" aria-hidden="true">
      <div class="site-orb site-orb--cobalt"></div>
      <div class="site-orb site-orb--signal"></div>
      <div class="site-grid"></div>
    </div>

    <a class="skip-link" href="#top">{{ t.common.skip_to_content }}</a>

    <header class="site-header">
      <div class="page-shell">
        <div class="site-nav" data-reveal>
          <a class="brand-mark" href="#top" aria-label="{{ identity.name | attr }}">
            <img class="brand-mark__monogram" src="{{ identity.header_avatar_url }}" alt="" aria-hidden="true" loading="eager" decoding="async" />
            <span class="brand-mark__copy">
              <span class="brand-mark__name">{{ identity.name }}</span>
              <span class="brand-mark__role">{{ identity.role }}</span>
            </span>
          </a>

          <nav class="site-nav__links" aria-label="{{ t.common.nav_aria | attr }}">
            <a href="#focus">{{ t.cv.nav.focus }}</a>
            <a href="#experience">{{ t.cv.nav.experience }}</a>
            <a href="#case-studies">{{ t.cv.nav.case_studies }}</a>
            <a href="#public-work">{{ t.cv.nav.public_work }}</a>
            <a href="{{ links.services }}">{{ t.cv.nav.hire }}</a>
            <a href="#contact">{{ t.cv.nav.contact }}</a>
          </nav>

          <div class="site-nav__actions">
{% include "partials/lang-switch.njk" %}
            <a class="mini-action" href="{{ links.resume_pdf }}">
              <span class="mini-action__icon">{{ ui_icons.download }}</span>
              <span>{{ t.cv.actions.pdf_short }}</span>
            </a>
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="{{ t.common.theme.aria | attr }}" aria-pressed="false">
              <span class="theme-toggle__icon">
                <span class="theme-toggle__icon-sun">{{ ui_icons.sun }}</span>
                <span class="theme-toggle__icon-moon">{{ ui_icons.moon }}</span>
              </span>
              <span data-theme-label>{{ t.common.theme.dark }}</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="top" class="site-main">
      <section class="hero-section">
        <div class="page-shell">
          <div class="hero-grid" data-reveal>
              <div class="hero-intro">
                <div class="hero-kicker-row">
                  <span class="section-kicker">{{ t.cv.hero.kicker }}</span>
                </div>

                <h1 class="hero-title">{{ identity.hero_title }}</h1>
                <p class="hero-tagline">{{ identity.hero_tagline }}</p>

                <div class="hero-actions">
                  {% for link in cta.primary -%}
                    {% if loop.index <= 2 -%}
                      {% set ctaIcon = ui_icons.mail -%}
                      {% if link.label == "Telegram" -%}
                        {% set ctaIcon = ui_icons.send -%}
                      {% elseif link.label == "GitHub" -%}
                        {% set ctaIcon = ui_icons.github -%}
                      {% endif -%}
                      <a class="{% if loop.first %}site-button site-button--primary{% else %}site-button site-button--secondary{% endif %}" href="{{ link.href }}">
                        <span class="site-button__icon">{{ ctaIcon }}</span>
                        <span>{{ link.label }}</span>
                      </a>
                    {% endif -%}
                  {% endfor %}
                </div>
              </div>

              <div class="hero-stage">
                <div class="portrait-stack">
                  <div class="portrait-glow" aria-hidden="true"></div>
                  <img
                    class="portrait-image"
                    src="{{ identity.avatar_url }}"
                    alt="{{ t.cv.hero.portrait_alt | attr }}"
                    width="640"
                    height="640"
                    loading="eager"
                    decoding="async"
                  />
                  <span class="orbit-bubble orbit-bubble--1" aria-hidden="true">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg" alt="" loading="lazy" />
                  </span>
                  <span class="orbit-bubble orbit-bubble--2" aria-hidden="true">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/angular/angular-original.svg" alt="" loading="lazy" />
                  </span>
                  <span class="orbit-bubble orbit-bubble--3" aria-hidden="true">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg" alt="" loading="lazy" />
                  </span>
                  <span class="orbit-bubble orbit-bubble--4" aria-hidden="true">
                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/fastapi/fastapi-original.svg" alt="" loading="lazy" />
                  </span>
                </div>
              </div>
            </div>

            <div class="hero-stats-grid">
              {% for card in t.cv.hero_cards -%}
              {% if card.href -%}
              <a href="{{ card.href }}" class="hero-stat-card hero-stat-card--link hero-stat-card--{{ card.modifier }}">
              {% else -%}
              <article class="hero-stat-card hero-stat-card--{{ card.modifier }}">
              {% endif -%}
                <div class="hero-stat-card__visual">
                  <img src="/media/illustrations/{{ card.illustration }}.svg" data-theme-src data-light-src="/media/illustrations/{{ card.illustration }}.svg" data-dark-src="/media/illustrations/dark/{{ card.illustration }}.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                </div>
                <div class="hero-stat-card__content">
                  <div class="hero-stat-card__value">{{ card.value }}</div>
                  <div class="hero-stat-card__label">{{ card.label }}</div>
                  <div class="hero-stat-card__meta">{{ card.meta }}</div>
                </div>
              {% if card.href -%}
              </a>
              {% else -%}
              </article>
              {% endif -%}
              {% endfor %}
            </div>
        </div>
      </section>

      <section id="focus" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.cv.focus.kicker }}</div>
            <h2 class="section-heading">{{ t.cv.focus.heading }}</h2>
            <p class="section-lede">
              {{ t.cv.focus.lede }}
            </p>
          </div>

          <aside class="focus-narrative" data-reveal>
            <div class="focus-narrative__rail" aria-hidden="true">
              <span class="focus-narrative__marker">{{ ui_icons.sparkles }}</span>
            </div>
            <div class="focus-narrative__content">
              <div class="focus-narrative__label">{{ t.cv.focus.narrative_label }}</div>
              <p class="focus-narrative__copy">{{ identity.current_focus }}</p>
            </div>
          </aside>

          <div class="value-card-grid" data-reveal>
            {% for item in value_props -%}
            <article class="value-card" data-reveal>
              <div class="value-card__head">
                <span class="value-card__number">0{{ loop.index }}</span>
                <div class="value-card__icon">{{ ui_icons[item.icon] }}</div>
              </div>
              <h3 class="value-card__title">{{ item.title }}</h3>
              <p class="value-card__copy">{{ item.description }}</p>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="experience" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.cv.experience.kicker }}</div>
            <h2 class="section-heading">{{ t.cv.experience.heading }}</h2>
            <p class="section-lede">
              {{ t.cv.experience.lede }}
            </p>
          </div>

          <div class="timeline-list">
            {% for job in experience -%}
            <article class="timeline-entry" data-reveal>
              <div class="timeline-entry__rail">
                <span class="timeline-entry__dot"></span>
              </div>
              <div class="timeline-entry__card">
                <div class="timeline-entry__header">
                  <div class="timeline-entry__head-left">
                    {% if job.logo -%}
                    <img class="timeline-entry__logo" src="{{ job.logo }}" alt="{{ job.company | attr }}" loading="lazy" decoding="async" />
                    {% endif -%}
                    <div>
                      <div class="timeline-entry__company">{{ job.company }}</div>
                      <h3 class="timeline-entry__role">{{ job.role }}</h3>
                    </div>
                  </div>
                  <div class="timeline-entry__range">{{ job.range }}</div>
                </div>
                <p class="timeline-entry__summary">{{ job.summary }}</p>
                <div class="timeline-entry__highlights">
                  {% for highlight in job.highlights -%}
                  <div class="timeline-entry__highlight">{{ highlight }}</div>
                  {% endfor %}
                </div>
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="case-studies" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.cv.case_studies.kicker }}</div>
            <h2 class="section-heading">{{ t.cv.case_studies.heading }}</h2>
            <p class="section-lede">
              {{ t.cv.case_studies.lede }}
            </p>
          </div>

          <div class="case-study-grid">
            {% for caseStudy in site_case_studies -%}
            <article class="case-study-card" id="case-{{ caseStudy.key }}" data-reveal>
              <div class="case-study-card__topline">
                <span class="case-study-card__icon">{{ ui_icons[caseStudy.icon] }}</span>
                <span class="section-kicker">{{ caseStudy.kind }}</span>
                {% if caseStudy.impact -%}
                <span class="impact-pill">{{ caseStudy.impact.value }} {{ caseStudy.impact.label }}</span>
                {% endif -%}
              </div>
              <h3 class="case-study-card__title">{{ caseStudy.title }}</h3>
              <p class="case-study-card__summary">{{ caseStudy.summary }}</p>

              <div class="case-study-card__role-block">
                <div class="case-study-card__role-label">{{ t.cv.case_studies.role_label }}</div>
                <div class="case-study-card__role-copy">{{ caseStudy.role }}</div>
              </div>

              <div class="case-study-card__chips">
                {% for item in caseStudy.stack -%}
                <span class="site-chip">{{ item }}</span>
                {% endfor %}
              </div>

              <div class="case-study-card__highlights">
                {% for highlight in caseStudy.highlights -%}
                <div class="case-study-card__highlight">{{ highlight }}</div>
                {% endfor %}
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="public-work" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.cv.public_work.kicker }}</div>
            <h2 class="section-heading">{{ t.cv.public_work.heading }}</h2>
            <p class="section-lede">
              {{ t.cv.public_work.lede }}
            </p>
          </div>

          <aside class="evidence-note" data-reveal>
            <span class="evidence-note__icon">{{ ui_icons["book-open"] }}</span>
            <div class="evidence-note__content">
              <h3 class="evidence-note__title">{{ t.cv.public_work.note_title }}</h3>
              <p class="evidence-note__copy">{{ t.cv.public_work.note_body }}</p>
            </div>
          </aside>

          <div class="repo-grid">
            {% for repo in selected_public_repos -%}
            <article class="repo-card" data-reveal>
              {% if repo.visual -%}
              <div class="repo-card__visual repo-card__visual--{{ repo.visual.kind }}">
                <img
                  src="{{ repo.visual.src }}"
                  {% if "/media/illustrations/" in repo.visual.src -%}
                  data-theme-src
                  data-light-src="{{ repo.visual.src }}"
                  data-dark-src="{{ repo.visual.src | replace('/media/illustrations/', '/media/illustrations/dark/') }}"
                  {% endif -%}
                  alt="{{ repo.visual.alt | attr }}"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {% endif -%}
              <div class="repo-card__header">
                <div class="repo-card__title-wrap">
                  <span class="repo-card__icon">{{ ui_icons[repo.icon] }}</span>
                  <div>
                    <div class="section-kicker">{{ t.common.github_repo }}</div>
                    <h3 class="repo-card__title">{{ repo.label }}</h3>
                  </div>
                </div>
                <a class="repo-card__action repo-card__action--github" href="{{ repo.url }}" aria-label="{{ repo.label | attr }} — {{ t.common.view_on_github | attr }}">
                  <span class="repo-card__action-icon">{{ ui_icons.github }}</span>
                  <span>{{ t.common.view_on_github }}</span>
                </a>
              </div>
              <p class="repo-card__summary">{{ repo.summary }}</p>
              <div class="repo-card__chips">
                {% for item in repo.stack -%}
                <span class="site-chip site-chip--warm">{{ item }}</span>
                {% endfor %}
              </div>
            </article>
            {% endfor %}
          </div>

          <div class="supporting-project" data-reveal>
            <div class="supporting-project__content">
              <div class="supporting-project__head">
                <span class="supporting-project__icon">{{ ui_icons["book-open"] }}</span>
                <div>
                  <div class="section-kicker">{{ t.cv.public_work.supporting_kicker }}</div>
                  <h3 class="supporting-project__title">{{ supporting_repo.label }}</h3>
                </div>
              </div>
              <p class="supporting-project__copy">{{ supporting_repo.summary }}</p>
            </div>
            <a class="repo-card__action repo-card__action--github" href="{{ supporting_repo.url }}" aria-label="{{ supporting_repo.label | attr }} — {{ t.common.view_on_github | attr }}">
              <span class="repo-card__action-icon">{{ ui_icons.github }}</span>
              <span>{{ t.common.view_on_github }}</span>
            </a>
          </div>
        </div>
      </section>

      <section class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.cv.stack.kicker }}</div>
            <h2 class="section-heading">{{ t.cv.stack.heading }}</h2>
          </div>

          <div class="stack-grid">
            {% for group in stack_groups -%}
            <article class="stack-card" data-reveal>
              <div class="stack-card__bar"></div>
              <h3 class="stack-card__title">{{ group.label }}</h3>
              <div class="stack-card__chips">
                {% for item in group.items -%}
                {% if item.icon -%}
                <span class="site-chip site-chip--with-logo">
                  <img class="site-chip__logo" src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/{{ item.icon }}/{{ item.icon }}-original.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                  {{ item.name }}
                </span>
                {% elseif item.name -%}
                <span class="site-chip">{{ item.name }}</span>
                {% else -%}
                <span class="site-chip">{{ item }}</span>
                {% endif -%}
                {% endfor %}
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="site-section">
        <div class="page-shell">
          <div class="knowledge-grid">
            <div class="knowledge-column">
              <div class="section-intro" data-reveal>
                <div class="section-kicker">{{ t.cv.education.kicker }}</div>
                <h2 class="section-heading">{{ t.cv.education.heading }}</h2>
              </div>
              <div class="knowledge-list">
                {% for entry in education -%}
                <article class="knowledge-card" data-reveal>
                  <div class="knowledge-card__meta">{{ entry.range }}</div>
                  {% if entry.logo -%}
                  <img class="knowledge-card__logo" src="{{ entry.logo }}" alt="{{ entry.school | attr }}" loading="lazy" decoding="async" />
                  {% endif -%}
                  <h3 class="knowledge-card__title">{{ entry.school }}</h3>
                  <p class="knowledge-card__copy">{{ entry.degree }}</p>
                </article>
                {% endfor %}
                <article class="knowledge-card knowledge-card--languages" data-reveal>
                  <div class="knowledge-card__meta">{{ t.cv.languages.kicker }}</div>
                  <span class="knowledge-card__icon">{{ ui_icons.languages }}</span>
                  <h3 class="knowledge-card__title">{{ t.cv.languages.heading }}</h3>
                  <ul class="knowledge-card__list">
                    {% for language in languages -%}
                    <li><span class="knowledge-card__list-term">{{ language.name }}</span> — {{ language.level }}</li>
                    {% endfor %}
                  </ul>
                </article>
              </div>
            </div>

            <div class="knowledge-column">
              <div class="section-intro" data-reveal>
                <div class="section-kicker">{{ t.cv.achievements.kicker }}</div>
                <h2 class="section-heading">{{ t.cv.achievements.heading }}</h2>
              </div>
              <div class="knowledge-list">
                {% for item in achievements -%}
                <article class="knowledge-card" data-reveal>
                  <div class="knowledge-card__year">{{ item.year }}</div>
                  <h3 class="knowledge-card__title">{{ item.title }}</h3>
                  <p class="knowledge-card__copy">{{ item.description }}</p>
                </article>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="contact" class="site-section site-section--contact">
        <div class="page-shell">
          <div class="contact-panel" data-reveal>
            <div class="contact-panel__copy">
              <div class="section-kicker">{{ t.cv.contact.kicker }}</div>
              <h2 class="section-heading">{{ t.cv.contact.heading }}</h2>
              <p class="section-lede">
                {{ t.cv.contact.lede }}
              </p>
              <div class="contact-panel__actions">
                {% for link in cta.footer -%}
                {% set footerIcon = ui_icons.mail -%}
                {% if link.label == "Telegram" -%}
                {% set footerIcon = ui_icons.send -%}
                {% elseif link.label == "GitHub" -%}
                {% set footerIcon = ui_icons.github -%}
                {% elseif link.label == "LinkedIn" -%}
                {% set footerIcon = ui_icons.linkedin -%}
                {% elseif link.label == "VK" -%}
                {% set footerIcon = ui_icons["messages-square"] -%}
                {% endif -%}
                <a class="{% if loop.first %}site-button site-button--primary{% else %}site-button site-button--secondary{% endif %}" href="{{ link.href }}">
                  <span class="site-button__icon">{{ footerIcon }}</span>
                  <span>{{ link.label }}</span>
                  <span class="site-button__meta">{{ link.short }}</span>
                </a>
                {% endfor %}
                <a class="site-button site-button--secondary" href="{{ links.resume_pdf }}">
                  <span class="site-button__icon">{{ ui_icons.download }}</span>
                  <span>{{ t.cv.actions.pdf_long }}</span>
                </a>
              </div>
            </div>
            <div class="contact-panel__visual">
              <img src="/media/illustrations/web-developer.svg" data-theme-src data-light-src="/media/illustrations/web-developer.svg" data-dark-src="/media/illustrations/dark/web-developer.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" />
            </div>
          </div>

          <a class="cv-band" href="{{ links.services }}" data-reveal>
            <span class="cv-band__copy">
              <span class="cv-band__title">{{ t.cv.cv_band.title }}</span>
              <span class="cv-band__meta">{{ t.cv.cv_band.meta }}</span>
            </span>
            <span class="cv-band__icon">{{ ui_icons["arrow-right"] }}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-shell">
        <div class="site-footer__inner">
          <div class="site-footer__copy">
            <span class="site-footer__name">{{ identity.name }}</span>
            <span class="site-footer__separator">&middot;</span>
            <span class="site-footer__role">{{ identity.role }}</span>
          </div>
          <div class="site-footer__links">
            <a href="{{ identity.github }}">GitHub</a>
            <a href="{{ identity.telegram }}">Telegram</a>
            <a href="{{ identity.linkedin }}">LinkedIn</a>
            <a href="mailto:{{ identity.email }}">Email</a>
          </div>
{% include "partials/lang-switch.njk" %}
        </div>
      </div>
    </footer>

{% include "partials/behaviour.njk" %}
  </body>
</html>
