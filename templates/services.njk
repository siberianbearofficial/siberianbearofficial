<!doctype html>
<html lang="{{ lang }}">
  <head>
    {% include "partials/head.njk" %}
    {% include "partials/boot-scripts.njk" %}
    <link rel="stylesheet" href="/assets/site.css" />
    <script type="application/ld+json">{{ structured_data | json }}</script>
  </head>
  <body data-page="site">
    <div class="site-backdrop" aria-hidden="true">
      <div class="site-orb site-orb--cobalt"></div>
      <div class="site-orb site-orb--signal"></div>
      <div class="site-grid"></div>
    </div>

    <a class="skip-link" href="#top">{{ t.common.skip_to_content }}</a>

    <header class="site-header">
      <div class="page-shell">
        <div class="site-nav" data-reveal>
          <a class="brand-mark" href="#top" aria-label="{{ identity.name | attr }}">
            <img class="brand-mark__monogram" src="{{ identity.header_avatar_url }}" alt="" aria-hidden="true" loading="eager" decoding="async" />
            <span class="brand-mark__copy">
              <span class="brand-mark__name">{{ identity.name }}</span>
              <span class="brand-mark__role">{{ t.services.brand_role }}</span>
            </span>
          </a>

          <nav class="site-nav__links" aria-label="{{ t.common.nav_aria | attr }}">
            <a href="#services">{{ t.services.nav.services }}</a>
            <a href="#work">{{ t.services.nav.work }}</a>
            <a href="#process">{{ t.services.nav.process }}</a>
            <a href="#faq">{{ t.services.nav.faq }}</a>
            <a href="#contact">{{ t.services.nav.contact }}</a>
          </nav>

          <div class="site-nav__actions">
{% include "partials/lang-switch.njk" %}
            <a class="mini-action mini-action--cta" href="{{ hero.primary_cta.href }}">
              <span class="mini-action__icon">{{ ui_icons.send }}</span>
              <span>{{ t.services.actions.book_call }}</span>
            </a>
            <button class="theme-toggle" type="button" data-theme-toggle aria-label="{{ t.common.theme.aria | attr }}" aria-pressed="false">
              <span class="theme-toggle__icon">
                <span class="theme-toggle__icon-sun">{{ ui_icons.sun }}</span>
                <span class="theme-toggle__icon-moon">{{ ui_icons.moon }}</span>
              </span>
              <span data-theme-label>{{ t.common.theme.dark }}</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="top" class="site-main">
      <section class="hero-section">
        <div class="page-shell">
          <div class="offer-hero" data-reveal>
            <div class="hero-kicker-row">
              <span class="status-pill">
                <span class="status-pill__dot"></span>
                {{ hero.kicker }}
              </span>
            </div>

            <h1 class="hero-title">{{ hero.title }}</h1>
            <p class="hero-tagline">{{ hero.lede }}</p>

            <p class="offer-hero__proof">
              <span class="offer-hero__proof-icon">{{ ui_icons["badge-check"] }}</span>
              <span>{{ hero.proof }}</span>
            </p>

            <div class="hero-actions">
              <a class="site-button site-button--primary" href="{{ hero.primary_cta.href }}">
                <span class="site-button__icon">{{ ui_icons.send }}</span>
                <span>{{ hero.primary_cta.label }}</span>
              </a>
              <a class="site-button site-button--secondary" href="{{ hero.secondary_cta.href }}">
                <span class="site-button__icon">{{ ui_icons["arrow-right"] }}</span>
                <span>{{ hero.secondary_cta.label }}</span>
              </a>
            </div>
          </div>

          <div class="proof-bar" data-reveal>
            {% for point in proof_points -%}
            <article class="proof-point">
              <span class="proof-point__icon">{{ ui_icons[point.icon] }}</span>
              <div class="proof-point__content">
                <div class="proof-point__value">{{ point.value }}</div>
                <div class="proof-point__label">{{ point.label }}</div>
                <div class="proof-point__meta">{{ point.meta }}</div>
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="services" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.services.offers.kicker }}</div>
            <h2 class="section-heading">{{ t.services.offers.heading }}</h2>
            <p class="section-lede">
              {{ t.services.offers.lede }}
            </p>
          </div>

          <div class="offer-grid">
            {% for service in services -%}
            <article class="offer-card{% if service.featured %} offer-card--featured{% endif %}" id="service-{{ service.key }}" data-reveal>
              {% if service.featured -%}
              <span class="offer-card__badge">{{ t.services.offers.featured_badge }}</span>
              {% endif -%}
              <div class="offer-card__head">
                <span class="offer-card__icon">{{ ui_icons[service.icon] }}</span>
                <h3 class="offer-card__name">{{ service.name }}</h3>
              </div>

              <div class="offer-card__pricing">
                <span class="offer-card__price">{{ service.price }}</span>
                <span class="offer-card__timeline">
                  <span class="offer-card__timeline-icon">{{ ui_icons["calendar-clock"] }}</span>
                  {{ service.timeline }}
                </span>
              </div>

              <div class="offer-card__block">
                <div class="offer-card__block-label">{{ t.services.offers.problem_label }}</div>
                <p class="offer-card__block-copy">{{ service.problem }}</p>
              </div>

              <div class="offer-card__block offer-card__block--outcome">
                <div class="offer-card__block-label">{{ t.services.offers.outcome_label }}</div>
                <p class="offer-card__block-copy">{{ service.outcome }}</p>
              </div>

              <ul class="offer-card__includes">
                {% for item in service.includes -%}
                <li class="offer-card__include">
                  <span class="offer-card__include-icon">{{ ui_icons["circle-check"] }}</span>
                  <span>{{ item }}</span>
                </li>
                {% endfor %}
              </ul>

              {% if service.footnote -%}
              <p class="offer-card__footnote">{{ service.footnote }}</p>
              {% endif -%}

              <a class="offer-card__cta" href="#contact">
                <span>{{ t.services.actions.discuss }}</span>
                <span class="offer-card__cta-icon">{{ ui_icons["arrow-right"] }}</span>
              </a>
            </article>
            {% endfor %}
          </div>

          <div class="retainer-panel" data-reveal>
            <div class="retainer-panel__copy">
              <div class="retainer-panel__head">
                <span class="retainer-panel__icon">{{ ui_icons[retainer.icon] }}</span>
                <div>
                  <div class="section-kicker">{{ t.services.offers.retainer_kicker }}</div>
                  <h3 class="retainer-panel__title">{{ retainer.name }}</h3>
                </div>
              </div>
              <p class="retainer-panel__summary">{{ retainer.summary }}</p>
              <div class="retainer-panel__price">{{ retainer.price }}</div>
            </div>
            <ul class="retainer-panel__list">
              {% for item in retainer.includes -%}
              <li class="retainer-panel__item">
                <span class="retainer-panel__item-icon">{{ ui_icons["circle-check"] }}</span>
                <span>{{ item }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </section>

      <section class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.services.principles.kicker }}</div>
            <h2 class="section-heading">{{ t.services.principles.heading }}</h2>
          </div>

          <div class="principle-grid">
            {% for item in engagement_principles -%}
            <article class="principle-card" data-reveal>
              <span class="principle-card__icon">{{ ui_icons[item.icon] }}</span>
              <h3 class="principle-card__title">{{ item.title }}</h3>
              <p class="principle-card__copy">{{ item.description }}</p>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="work" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.services.work.kicker }}</div>
            <h2 class="section-heading">{{ t.services.work.heading }}</h2>
            <p class="section-lede">
              {{ t.services.work.lede }}
            </p>
          </div>

          <div class="story-list">
            {% for story in case_studies -%}
            <article class="story-card" id="case-{{ story.key }}" data-reveal>
              <div class="story-card__header">
                <div class="story-card__topline">
                  <span class="story-card__icon">{{ ui_icons[story.icon] }}</span>
                  <span class="section-kicker">{{ story.kind }}</span>
                  {% if story.impact -%}
                  <span class="impact-pill">{{ story.impact.value }} {{ story.impact.label }}</span>
                  {% endif -%}
                </div>
                <h3 class="story-card__title">{{ story.title }}</h3>
              </div>

              <div class="story-card__beats">
                <div class="story-beat story-beat--problem">
                  <div class="story-beat__label">{{ t.services.work.problem_label }}</div>
                  <p class="story-beat__copy">{{ story.problem }}</p>
                </div>
                <div class="story-beat story-beat--action">
                  <div class="story-beat__label">{{ t.services.work.action_label }}</div>
                  <p class="story-beat__copy">{{ story.action }}</p>
                </div>
                <div class="story-beat story-beat--result">
                  <div class="story-beat__label">{{ t.services.work.result_label }}</div>
                  <p class="story-beat__copy">{{ story.result }}</p>
                </div>
              </div>

              <div class="story-card__chips">
                {% for item in story.stack -%}
                <span class="site-chip">{{ item }}</span>
                {% endfor %}
              </div>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.services.evidence.kicker }}</div>
            <h2 class="section-heading">{{ t.services.evidence.heading }}</h2>
            <p class="section-lede">{{ evidence.intro }}</p>
          </div>

          <div class="evidence-grid">
            {% for repo in evidence.repos -%}
            <article class="evidence-card" data-reveal>
              <div class="evidence-card__head">
                <span class="evidence-card__icon">{{ ui_icons[repo.icon] }}</span>
                <h3 class="evidence-card__title">{{ repo.label }}</h3>
              </div>
              <p class="evidence-card__relevance">{{ repo.relevance }}</p>
              <div class="evidence-card__chips">
                {% for item in repo.stack -%}
                <span class="site-chip site-chip--warm">{{ item }}</span>
                {% endfor %}
              </div>
              <a class="repo-card__action repo-card__action--github" href="{{ repo.url }}" aria-label="{{ repo.label | attr }} — {{ t.common.view_on_github | attr }}">
                <span class="repo-card__action-icon">{{ ui_icons.github }}</span>
                <span>{{ t.common.view_on_github }}</span>
              </a>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="process" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.services.process.kicker }}</div>
            <h2 class="section-heading">{{ t.services.process.heading }}</h2>
          </div>

          <div class="process-grid">
            {% for step in process -%}
            <article class="process-step" data-reveal>
              <div class="process-step__head">
                <span class="process-step__index">0{{ loop.index }}</span>
                <span class="process-step__icon">{{ ui_icons[step.icon] }}</span>
              </div>
              <h3 class="process-step__title">{{ step.step }}</h3>
              <div class="process-step__duration">{{ step.duration }}</div>
              <p class="process-step__copy">{{ step.description }}</p>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="faq" class="site-section">
        <div class="page-shell">
          <div class="section-intro" data-reveal>
            <div class="section-kicker">{{ t.services.faq.kicker }}</div>
            <h2 class="section-heading">{{ t.services.faq.heading }}</h2>
          </div>

          <div class="faq-grid">
            {% for item in faq -%}
            <article class="faq-item" data-reveal>
              <h3 class="faq-item__question">{{ item.question }}</h3>
              <p class="faq-item__answer">{{ item.answer }}</p>
            </article>
            {% endfor %}
          </div>
        </div>
      </section>

      <section id="contact" class="site-section site-section--contact">
        <div class="page-shell">
          <div class="contact-panel" data-reveal>
            <div class="contact-panel__copy">
              <div class="section-kicker">{{ t.services.contact.kicker }}</div>
              <h2 class="section-heading">{{ contact.heading }}</h2>
              <p class="section-lede">{{ contact.lede }}</p>
              <div class="contact-panel__actions">
                {% for link in contact.links -%}
                {% set contactIcon = ui_icons.mail -%}
                {% if link.label == "Telegram" -%}
                {% set contactIcon = ui_icons.send -%}
                {% elseif link.label == "GitHub" -%}
                {% set contactIcon = ui_icons.github -%}
                {% elseif link.label == "LinkedIn" -%}
                {% set contactIcon = ui_icons.linkedin -%}
                {% endif -%}
                <a class="{% if loop.first %}site-button site-button--primary{% else %}site-button site-button--secondary{% endif %}" href="{{ link.href }}">
                  <span class="site-button__icon">{{ contactIcon }}</span>
                  <span>{{ link.label }}</span>
                  <span class="site-button__meta">{{ link.short }}</span>
                </a>
                {% endfor %}
              </div>
            </div>
            <div class="contact-panel__visual">
              <img src="/media/illustrations/chat-with-ai.svg" data-theme-src data-light-src="/media/illustrations/chat-with-ai.svg" data-dark-src="/media/illustrations/dark/chat-with-ai.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" />
            </div>
          </div>

          <a class="cv-band" href="{{ links.cv }}" data-reveal>
            <span class="cv-band__copy">
              <span class="cv-band__title">{{ site.cv_label }}</span>
              <span class="cv-band__meta">{{ t.services.cv_band.meta }}</span>
            </span>
            <span class="cv-band__icon">{{ ui_icons["arrow-right"] }}</span>
          </a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-shell">
        <div class="site-footer__inner">
          <div class="site-footer__copy">
            <span class="site-footer__name">{{ identity.name }}</span>
            <span class="site-footer__separator">&middot;</span>
            <span class="site-footer__role">{{ t.services.brand_role }}</span>
          </div>
          <div class="site-footer__links">
            <a href="{{ links.cv }}">{{ t.services.footer_cv }}</a>
            <a href="{{ identity.github }}">GitHub</a>
            <a href="{{ identity.telegram }}">Telegram</a>
            <a href="{{ identity.linkedin }}">LinkedIn</a>
            <a href="mailto:{{ identity.email }}">Email</a>
          </div>
{% include "partials/lang-switch.njk" %}
        </div>
      </div>
    </footer>

{% include "partials/behaviour.njk" %}
  </body>
</html>
